<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher mark is the connection ring, the same signature element the
    home screen is built around. Drawn inside the 72x72 adaptive-icon safe zone
    (centre 54,54, radius 24) so no launcher mask can clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Full ring: closed, because the icon should read as "protected". -->
    <path
        android:pathData="M54,78 A24,24 0 1,1 54,30 A24,24 0 1,1 54,78 Z"
        android:strokeColor="#43E0C8"
        android:strokeWidth="6"
        android:strokeLineCap="round" />

</vector>
