<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup is disabled in the manifest, but these rules are declared so that if
    it is ever enabled, VPN profiles and the relay cache are never copied off
    the device. Only user preferences would be eligible.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <include domain="file" path="datastore/lucent_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <include domain="file" path="datastore/lucent_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
